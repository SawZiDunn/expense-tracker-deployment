# Copy this file to `.env` in the same directory as docker-compose.yml, then fill in
# the values. Docker Compose reads `.env` automatically for variable substitution.
#
#   cp .env.example .env
#   docker compose up --build
#
# Single-quote any value containing special characters such as $ or # so that
# Compose does not try to interpolate or parse them.

# --- Backend ------------------------------------------------------------------
# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Production

# --- Frontend -----------------------------------------------------------------
# Backend API URL baked into the frontend bundle at build time.
# Must be reachable from the browser, not the container network.
VITE_API_URL=http://localhost:8080

# or Development