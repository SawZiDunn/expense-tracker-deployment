# Optional overrides for `docker compose`.
#
# You do NOT need this file for a normal local run with docker - Compose falls back to
# sensible defaults (a local MongoDB container, and http://localhost:8080 as the
# API URL). Copy it only when you want to change something:
#
#   cp .env.example .env
#
# Single-quote any value containing special characters such as $ or # so that
# Compose does not try to interpolate or parse them.

# --- Database (optional) ------------------------------------------------------
# Leave this commented out to use the local MongoDB container that Compose starts.
# Uncomment and set it to use a cloud database (e.g. MongoDB Atlas) instead.
# MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# --- Backend (optional) -------------------------------------------------------
# ASPNETCORE_ENVIRONMENT defaults to Production. Uncomment to override.
# ASPNETCORE_ENVIRONMENT=Development

# --- Frontend (optional) ------------------------------------------------------
# Backend API URL baked into the frontend bundle at build time. Only used when you
# build the image locally (`docker compose up --build`); a prebuilt image already
# has its value baked in.
# VITE_API_URL=http://localhost:8080
